{
  "id": "qbittorrent",
  "name": "qBittorrent",
  "version": "0.2.0",
  "description": "View and manage torrents on a self-hosted qBittorrent instance.",
  "author": {
    "name": "death.au"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/deathau/termix-plugin-qbittorrent",
  "docs": "https://github.com/deathau/termix-plugin-qbittorrent/tree/main/docs",
  "category": "Productivity",
  "icon": "Download",
  "features": [
    "Connect to a qBittorrent 5.2+ WebUI with an API key",
    "Add torrents from magnet links and URLs",
    "Start, stop, recheck, reannounce and delete torrents, and change their queue position",
    "See a torrent's details, files and trackers",
    "Open a torrent's location in a Termix file browser tab"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": ["network:outbound", "network:serve", "ui:surface"],
  "contributes": {
    "tabs": [
      {
        "id": "qbittorrent",
        "titleKey": "tab.title",
        "icon": "Download",
        "openFrom": ["rail", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "manage",
        "titleKey": "permissions.manage.title",
        "descriptionKey": "permissions.manage.description",
        "defaultRoles": ["admin"]
      },
      {
        "name": "delete",
        "titleKey": "permissions.delete.title",
        "descriptionKey": "permissions.delete.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "baseUrl",
          "type": "string",
          "labelKey": "settings.admin.baseUrl.label",
          "descriptionKey": "settings.admin.baseUrl.description",
          "default": ""
        },
        {
          "key": "apiKey",
          "type": "secret",
          "labelKey": "settings.admin.apiKey.label",
          "descriptionKey": "settings.admin.apiKey.description"
        },
        {
          "key": "fileHostId",
          "type": "custom",
          "component": "qbittorrent-host-picker",
          "labelKey": "settings.admin.fileHostId.label",
          "descriptionKey": "settings.admin.fileHostId.description"
        },
        {
          "key": "qbtPathPrefix",
          "type": "string",
          "labelKey": "settings.admin.qbtPathPrefix.label",
          "descriptionKey": "settings.admin.qbtPathPrefix.description",
          "default": ""
        },
        {
          "key": "hostPathPrefix",
          "type": "string",
          "labelKey": "settings.admin.hostPathPrefix.label",
          "descriptionKey": "settings.admin.hostPathPrefix.description",
          "default": ""
        }
      ]
    },
    "uses": ["files.openHost"]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
